# =========================
# Stage 1: Build
# =========================
FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# If your application has a build step, uncomment:
# RUN npm run build


# =========================
# Stage 2: Runtime
# =========================
FROM node:22-alpine

# Install nginx only in final image
RUN apk add --no-cache nginx

WORKDIR /app

# Copy only required application files
COPY --from=build /app/package*.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app ./

# Copy nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

CMD ["sh", "-c", "npm start & nginx -g 'daemon off;'"]




